class BrokerError(RuntimeError):
    def __init__(self, code: str, receipt: dict[str, Any] | None = None):
        super().__init__(code)
        self.code = code
        self.receipt = receipt


def now() -> dt.datetime:
    return dt.datetime.now(tz=dt.timezone.utc)


def iso(value: dt.datetime | None = None) -> str:
    return (value or now()).isoformat(timespec="seconds").replace("+00:00", "Z")


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_json(path: pathlib.Path, value: dict[str, Any], mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(value, output, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def append_audit(event: dict[str, Any]) -> None:
    AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(AUDIT_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(descriptor, canonical_json(event) + b"\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def sanitize(value: Any, depth: int = 0) -> Any:
    if depth > 10:
        return "[depth-limited]"
    if isinstance(value, dict):
        result: dict[str, Any] = {}
        for key, item in list(value.items())[:300]:
            text_key = str(key)[:160]
            result[text_key] = "[redacted]" if SECRET_KEY.search(text_key) else sanitize(item, depth + 1)
        return result
    if isinstance(value, list):
        return [sanitize(item, depth + 1) for item in value[:500]]
    if isinstance(value, str):
        return value if len(value) <= 4096 else value[:4096] + "…"
    if isinstance(value, (int, float, bool)) or value is None:
        return value
    return str(value)[:4096]


def safe_run(
    command: list[str], *, timeout: int, cwd: pathlib.Path | None = None,
    stdin: bytes | None = None, env_extra: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}
    if env_extra:
        env.update(env_extra)
    try:
        return subprocess.run(
            command, cwd=str(cwd) if cwd else None, input=stdin,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout,
            check=False, env=env,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return subprocess.CompletedProcess(command, 124, stdout=b"", stderr=type(error).__name__.encode("ascii"))


def safe_run_to_file(
    command: list[str], *, output_path: pathlib.Path, timeout: int,
    cwd: pathlib.Path | None = None, env_extra: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}
    if env_extra:
        env.update(env_extra)
    try:
        with output_path.open("wb") as output:
            process = subprocess.run(
                command, cwd=str(cwd) if cwd else None, stdout=output,
                stderr=subprocess.PIPE, timeout=timeout, check=False, env=env,
            )
            output.flush()
            os.fsync(output.fileno())
        return subprocess.CompletedProcess(command, process.returncode, stdout=b"", stderr=process.stderr)
    except (OSError, subprocess.TimeoutExpired) as error:
        output_path.unlink(missing_ok=True)
        return subprocess.CompletedProcess(command, 124, stdout=b"", stderr=type(error).__name__.encode("ascii"))


def ensure_identifier(value: Any, label: str) -> str:
    if not isinstance(value, str) or not SAFE_ID.fullmatch(value):
        raise BrokerError(f"invalid_{label}")
    return value


def ensure_name(value: Any, label: str) -> str:
    if not isinstance(value, str) or not SAFE_NAME.fullmatch(value):
        raise BrokerError(f"invalid_{label}")
    return value


def ensure_sha256(value: Any, label: str = "sha256") -> str:
    if not isinstance(value, str) or not SHA256.fullmatch(value):
        raise BrokerError(f"invalid_{label}")
    return value


def require_fields(value: dict[str, Any], required: set[str], optional: set[str] | None = None) -> None:
    optional = optional or set()
    if not required.issubset(value) or not set(value).issubset(required | optional):
        raise BrokerError("unexpected_step_fields")


