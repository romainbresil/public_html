    def _mark_interrupted_runs(self) -> None:
        for path in RUN_DIR.glob("*.json"):
            try:
                value = json.loads(path.read_text(encoding="utf-8"))
                if value.get("status") in {"queued", "running", "cancelling"}:
                    rollback_results = []
                    rollback_failed = False
                    for rollback in reversed(value.get("rollbacks") or []):
                        try:
                            rollback_results.append({"status": "success", "result": sanitize(self.rollback_step(rollback))})
                        except Exception as error:
                            rollback_failed = True
                            code = error.code if isinstance(error, BrokerError) else "unexpected_rollback_error"
                            rollback_results.append({"status": "failed", "error": code})
                    value["status"] = "failed_critical" if rollback_failed else "failed_rolled_back"
                    value["finished_at"] = iso()
                    value["anomalies"] = list(value.get("anomalies", [])) + ["broker_restart_interrupted_run"]
                    value["steps"] = list(value.get("steps") or []) + [{
                        "status": "failed", "error": "broker_restart_interrupted_run", "rollback": rollback_results,
                    }]
                    atomic_json(path, value)
                    plan_path = PLAN_DIR / f"{value.get('plan_id')}.json"
                    if plan_path.is_file():
                        plan = json.loads(plan_path.read_text(encoding="utf-8"))
                        plan["state"] = value["status"]
                        atomic_json(plan_path, plan)
                    append_audit({
                        "timestamp": iso(), "operation": "recover_interrupted_run",
                        "run_id": value.get("run_id"), "result": value["status"],
                    })
            except Exception:
                continue

    def artifact(self, artifact_id: Any) -> ResolvedArtifact:
        identifier = str(artifact_id or "")
        try:
            uuid.UUID(identifier)
        except ValueError:
            raise BrokerError("invalid_artifact_id")
        directory = ARTIFACT_DIR / identifier
        manifest_path = directory / "manifest.json"
        payload = directory / "payload"
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            metadata = payload.lstat()
        except (OSError, json.JSONDecodeError):
            raise BrokerError("artifact_unavailable")
        if payload.is_symlink() or not stat.S_ISREG(metadata.st_mode):
            raise BrokerError("artifact_invalid")
        checksum = ensure_sha256(manifest.get("sha256"), "artifact_sha256")
        size = manifest.get("size_bytes")
        if not isinstance(size, int) or size <= 0 or size != metadata.st_size or sha256_file(payload) != checksum:
            raise BrokerError("artifact_integrity_failed")
        return ResolvedArtifact(identifier, payload, checksum, size, manifest)

    def _store_artifact_file(
        self, source_path: pathlib.Path, *, media_type: str, label: str, source: str,
        mission_id: str | None = None, work_id: str | None = None, run_id: str | None = None,
    ) -> dict[str, Any]:
        metadata = source_path.lstat()
        if source_path.is_symlink() or not stat.S_ISREG(metadata.st_mode) or metadata.st_size <= 0:
            raise BrokerError("generated_artifact_invalid")
        if metadata.st_size > self.raw_policy["max_generated_artifact_bytes"]:
            raise BrokerError("generated_artifact_too_large")
        artifact_id = str(uuid.uuid4())
        directory = ARTIFACT_DIR / artifact_id
        directory.mkdir(mode=0o700)
        target = directory / "payload"
        shutil.copyfile(source_path, target)
        target.chmod(0o600)
        manifest = {
            "schema": "elan-vps-v1.3-artifact-v1", "artifact_id": artifact_id, "created_at": iso(),
            "label": label[:180], "media_type": media_type[:180], "source": source,
            "size_bytes": target.stat().st_size, "sha256": sha256_file(target),
            "mission_id": mission_id, "work_id": work_id, "run_id": run_id,
        }
        atomic_json(directory / "manifest.json", manifest)
        append_audit({"timestamp": iso(), "operation": "store_artifact", "artifact_id": artifact_id, "sha256": manifest["sha256"], "size_bytes": manifest["size_bytes"], "source": source, "mission_id": mission_id, "work_id": work_id, "run_id": run_id, "result": "success"})
        return manifest

    def stage_text(self, request: dict[str, Any]) -> dict[str, Any]:
        require_fields(request, {"operation", "content", "expected_sha256", "media_type", "label"})
        content = request["content"]
        if not isinstance(content, str):
            raise BrokerError("invalid_text_content")
        raw = content.encode("utf-8")
        if not raw or len(raw) > self.raw_policy["max_inline_text_bytes"]:
            raise BrokerError("inline_text_size_refused")
        expected = ensure_sha256(request["expected_sha256"], "expected_sha256")
        if sha256_bytes(raw) != expected:
            raise BrokerError("artifact_hash_mismatch")
        descriptor, name = tempfile.mkstemp(dir=STATE_DIR)
        path = pathlib.Path(name)
        try:
            os.write(descriptor, raw)
            os.close(descriptor)
            return self._store_artifact_file(path, media_type=str(request["media_type"]), label=str(request["label"]), source="inline_text")
        finally:
            try:
                os.close(descriptor)
            except OSError:
                pass
            path.unlink(missing_ok=True)

    def stage_https(self, request: dict[str, Any]) -> dict[str, Any]:
        require_fields(request, {"operation", "url", "expected_sha256", "expected_size_bytes", "media_type", "label"})
        label = request["label"]
        if not isinstance(label, str) or not label or len(label) > 180:
            raise BrokerError("invalid_artifact_label")
        connector_transfer = label.startswith("qualified-connector-transfer:")
        url = self.policy.https_url(request["url"], allow_connector=connector_transfer)
        expected = ensure_sha256(request["expected_sha256"], "expected_sha256")
        expected_size = request["expected_size_bytes"]
        if not isinstance(expected_size, int) or not 0 < expected_size <= self.raw_policy["max_artifact_bytes"]:
            raise BrokerError("artifact_size_refused")
        opener = urllib.request.build_opener(NoRedirect())
        current = url
        temporary: pathlib.Path | None = None
        try:
            for _ in range(5):
                try:
                    descriptor, name = tempfile.mkstemp(prefix=".download-", dir=STATE_DIR)
                    temporary = pathlib.Path(name)
                    digest = hashlib.sha256()
                    total = 0
                    req = urllib.request.Request(current, headers={"User-Agent": f"elan-vps-v1/{VERSION}"})
                    with os.fdopen(descriptor, "wb") as output, opener.open(req, timeout=60) as response:
                        while True:
                            block = response.read(1024 * 1024)
                            if not block:
                                break
                            total += len(block)
                            if total > expected_size:
                                raise BrokerError("artifact_size_mismatch")
                            digest.update(block)
                            output.write(block)
                        output.flush(); os.fsync(output.fileno())
                    if total != expected_size or digest.hexdigest() != expected:
                        raise BrokerError("artifact_integrity_failed")
                    source = "connector_https" if connector_transfer else "https"
                    return self._store_artifact_file(temporary, media_type=str(request["media_type"]), label=label, source=source)
                except urllib.error.HTTPError as error:
                    if temporary:
                        temporary.unlink(missing_ok=True); temporary = None
                    if error.code not in {301, 302, 303, 307, 308}:
                        raise BrokerError("artifact_download_failed")
                    location = error.headers.get("Location")
                    if not location:
                        raise BrokerError("artifact_redirect_invalid")
                    current = self.policy.https_url(urllib.parse.urljoin(current, location), allow_connector=connector_transfer)
            raise BrokerError("artifact_redirect_limit")
        finally:
            if temporary:
                temporary.unlink(missing_ok=True)

    def _credential_value(self, profile_name: str, key: str) -> str:
        profile = self.policy.profile("credential_profiles", profile_name)
        paths = profile.get("paths")
        path_value = paths.get(key) if isinstance(paths, dict) else None
        if not isinstance(path_value, str) or not path_value.startswith("/"):
            raise BrokerError("credential_reference_invalid")
        path = pathlib.Path(path_value)
        try:
            metadata = path.lstat()
        except OSError:
            raise BrokerError("credential_reference_unavailable")
        if path.is_symlink() or not stat.S_ISREG(metadata.st_mode) or metadata.st_size <= 0 or metadata.st_size > 16_384:
            raise BrokerError("credential_reference_invalid")
        if metadata.st_uid != 0 or metadata.st_gid != 0 or metadata.st_mode & 0o077:
            raise BrokerError("credential_reference_permissions_unsafe")
        return path.read_text(encoding="utf-8").strip()

    def validate_step(self, raw: Any) -> dict[str, Any]:
        if not isinstance(raw, dict):
            raise BrokerError("invalid_procedure_step")
        require_fields(raw, {"step_id", "primitive", "args"}, {"timeout_seconds", "retry", "retry_delay_seconds", "when", "resource_lock"})
        step_id = ensure_identifier(raw["step_id"], "step_id")
        primitive = raw["primitive"]
        if primitive not in self.schemas:
            raise BrokerError("primitive_not_allowed")
        if not isinstance(raw["args"], dict):
            raise BrokerError("invalid_step_args")
        timeout = raw.get("timeout_seconds", min(900, self.raw_policy["max_step_timeout_seconds"]))
        retry = raw.get("retry", 0)
        delay = raw.get("retry_delay_seconds", 1)
        if not isinstance(timeout, int) or not 1 <= timeout <= self.raw_policy["max_step_timeout_seconds"]:
            raise BrokerError("invalid_step_timeout")
        if not isinstance(retry, int) or not 0 <= retry <= self.raw_policy["max_retry_count"]:
            raise BrokerError("invalid_retry")
        if not isinstance(delay, int) or not 0 <= delay <= 60:
            raise BrokerError("invalid_retry_delay")
        when = raw.get("when", {"mode": "always"})
        if not isinstance(when, dict) or when.get("mode") not in {"always", "result_equals"}:
            raise BrokerError("invalid_step_condition")
        if when.get("mode") == "result_equals":
            require_fields(when, {"mode", "step_id", "path", "value"})
            ensure_identifier(when["step_id"], "condition_step_id")
            if not isinstance(when["path"], str) or len(when["path"]) > 200:
                raise BrokerError("invalid_condition_path")
        lock_name = raw.get("resource_lock")
        if lock_name is not None:
            ensure_name(lock_name, "resource_lock")
        args = self._validate_args(primitive, raw["args"])
        return {"step_id": step_id, "primitive": primitive, "args": args, "timeout_seconds": timeout, "retry": retry, "retry_delay_seconds": delay, "when": when, "resource_lock": lock_name}

    def _validate_args(self, primitive: str, args: dict[str, Any]) -> dict[str, Any]:
        # Common helpers keep the public schema compact while all enforcement remains server-side.
        if primitive == "file_inventory":
            require_fields(args, {"paths"})
            paths = args["paths"]
            if not isinstance(paths, list) or not 1 <= len(paths) <= 100:
                raise BrokerError("invalid_inventory_paths")
            return {"paths": [str(self.policy.read_path(item)) for item in paths]}
        if primitive == "file_preflight":
            require_fields(args, {"items"})
            items = args["items"]
            if not isinstance(items, list) or not 1 <= len(items) <= 100:
                raise BrokerError("invalid_preflight_items")
            normalized = []
            for item in items:
                if not isinstance(item, dict):
                    raise BrokerError("invalid_preflight_item")
                require_fields(item, {"path", "expected_sha256"}, {"expected_mode", "expected_uid", "expected_gid"})
                normalized.append({
                    "path": str(self.policy.read_path(item["path"])),
                    "expected_sha256": ensure_sha256(item["expected_sha256"]),
                    "expected_mode": item.get("expected_mode"), "expected_uid": item.get("expected_uid"), "expected_gid": item.get("expected_gid"),
                })
            return {"items": normalized}
        if primitive == "protected_reference_check":
            require_fields(args, {"profile"})
            return {"profile": self.policy.protected_reference(args["profile"])["name"]}
        if primitive in {"install_file_atomic", "generated_artifact_export"}:
            require_fields(args, {"artifact_id", "destination"}, {"mode"})
            artifact = self.artifact(args["artifact_id"])
            mode = args.get("mode", "0600")
            if not isinstance(mode, str) or not re.fullmatch(r"0[0-7]{3}", mode):
                raise BrokerError("invalid_file_mode")
            return {"artifact_id": artifact.artifact_id, "artifact_sha256": artifact.sha256, "destination": str(self.policy.write_path(args["destination"])), "mode": mode}
        if primitive == "qualified_release_install":
            require_fields(args, {"artifact_id", "expected_version", "expected_source_commit"})
            artifact = self.artifact(args["artifact_id"])
            version = args["expected_version"]
            source_commit = args["expected_source_commit"]
            if version != VERSION or not isinstance(version, str) or not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
                raise BrokerError("qualified_release_version_refused")
            if not isinstance(source_commit, str) or not re.fullmatch(r"[a-f0-9]{40}", source_commit):
                raise BrokerError("qualified_release_commit_invalid")
            return {"artifact_id": artifact.artifact_id, "artifact_sha256": artifact.sha256, "expected_version": version, "expected_source_commit": source_commit}
        if primitive == "remove_file":
            require_fields(args, {"destination"})
            return {"destination": str(self.policy.write_path(args["destination"]))}
        if primitive in {"systemd_unit", "systemd_status", "journal_read"}:
            required = {"unit"} | ({"action"} if primitive == "systemd_unit" else set())
            optional = {"lines"} if primitive == "journal_read" else set()
            require_fields(args, required, optional)
            if args["unit"] not in self.policy.allowed_units:
                raise BrokerError("systemd_unit_not_allowed")
            result = {"unit": args["unit"]}
            if primitive == "systemd_unit":
                if args["action"] not in {"daemon-reload", "start", "stop", "restart", "enable", "disable"}:
                    raise BrokerError("systemd_action_not_allowed")
                result["action"] = args["action"]
            if primitive == "journal_read":
                lines = args.get("lines", 100)
                if not isinstance(lines, int) or not 1 <= lines <= 500:
                    raise BrokerError("invalid_log_lines")
                result["lines"] = lines
            return result
        if primitive == "http_probe":
            require_fields(args, {"url", "expected_status"}, {"json_status"})
            if args["url"] not in self.policy.allowed_probes:
                raise BrokerError("http_probe_url_refused")
            if not isinstance(args["expected_status"], int) or not 100 <= args["expected_status"] <= 599:
                raise BrokerError("invalid_http_status")
            return dict(args)
        if primitive in {"host_status", "docker_inventory"}:
            require_fields(args, set())
            return {}
        if primitive == "certificate_status":
            require_fields(args, {"hostname"}, {"port"})
            host = ensure_name(args["hostname"], "hostname")
            if host.lower() not in self.policy.allowed_certificate_hosts:
                raise BrokerError("certificate_host_not_allowed")
            port = args.get("port", 443)
            if not isinstance(port, int) or not 1 <= port <= 65535:
                raise BrokerError("invalid_port")
            return {"hostname": host, "port": port}
        if primitive == "docker_image_load":
            require_fields(args, {"artifact_id", "identity_artifact_id"})
            artifact = self.artifact(args["artifact_id"])
            identity = self.artifact(args["identity_artifact_id"])
            return {
                "artifact_id": artifact.artifact_id, "artifact_sha256": artifact.sha256,
                "identity_artifact_id": identity.artifact_id, "identity_artifact_sha256": identity.sha256,
            }
        if primitive == "docker_logs":
            require_fields(args, {"container"}, {"lines"})
            container = ensure_name(args["container"], "container")
            if not self._container_allowed(container):
                raise BrokerError("container_not_allowed")
            lines = args.get("lines", 100)
            if not isinstance(lines, int) or not 1 <= lines <= 500:
                raise BrokerError("invalid_log_lines")
            return {"container": container, "lines": lines}
        if primitive == "docker_compose_apply":
            require_fields(args, {"profile", "artifact_id"}, {"wait_seconds"})
            profile = self.policy.profile("compose_profiles", args["profile"])
            artifact = self.artifact(args["artifact_id"])
            wait = args.get("wait_seconds", 180)
            if not isinstance(wait, int) or not 1 <= wait <= 900:
                raise BrokerError("invalid_wait_seconds")
            return {"profile": profile["name"], "artifact_id": artifact.artifact_id, "artifact_sha256": artifact.sha256, "wait_seconds": wait}
        if primitive == "docker_health_wait":
            require_fields(args, {"containers"}, {"timeout_seconds"})
            containers = args["containers"]
            if not isinstance(containers, list) or not 1 <= len(containers) <= 30:
                raise BrokerError("invalid_containers")
            normalized = [ensure_name(item, "container") for item in containers]
            if not all(self._container_allowed(item) for item in normalized):
                raise BrokerError("container_not_allowed")
            timeout = args.get("timeout_seconds", 180)
            if not isinstance(timeout, int) or not 1 <= timeout <= 900:
                raise BrokerError("invalid_wait_seconds")
            return {"containers": normalized, "timeout_seconds": timeout}
        if primitive.startswith("postgres_"):
            return self._validate_postgres_args(primitive, args)
        if primitive.startswith("n8n_"):
            return self._validate_n8n_args(primitive, args)
        if primitive.startswith("object_storage_"):
            return self._validate_object_args(primitive, args)
        if primitive.startswith("generated_artifact_"):
            if primitive == "generated_artifact_list":
                require_fields(args, set(), {"mission_id", "work_id"})
                return {key: ensure_identifier(value, key) for key, value in args.items()}
            if primitive == "generated_artifact_manifest":
                require_fields(args, {"artifact_id"})
                return {"artifact_id": self.artifact(args["artifact_id"]).artifact_id}
        if primitive == "isolated_python":
            require_fields(args, {"script_artifact_id", "input_artifacts"}, {"timeout_seconds"})
            script = self.artifact(args["script_artifact_id"])
            inputs = args["input_artifacts"]
            if not isinstance(inputs, dict) or len(inputs) > 40:
                raise BrokerError("invalid_isolated_inputs")
            resolved = {}
            for name, artifact_id in inputs.items():
                resolved[ensure_name(name, "input_name")] = self.artifact(artifact_id).artifact_id
            timeout = args.get("timeout_seconds", 900)
            if not isinstance(timeout, int) or not 1 <= timeout <= self.raw_policy["max_step_timeout_seconds"]:
                raise BrokerError("invalid_step_timeout")
            return {"script_artifact_id": script.artifact_id, "script_sha256": script.sha256, "input_artifacts": resolved, "timeout_seconds": timeout}
        raise BrokerError("primitive_validation_not_implemented")

    def _container_allowed(self, container: str) -> bool:
        allowed: set[str] = set()
        for group in ("postgres_profiles", "n8n_profiles"):
            for profile in self.raw_policy[group].values():
                if isinstance(profile, dict) and isinstance(profile.get("container"), str):
                    allowed.add(profile["container"])
        for profile in self.raw_policy["compose_profiles"].values():
            if isinstance(profile, dict) and isinstance(profile.get("containers"), list):
                allowed.update(str(item) for item in profile["containers"])
        return container in allowed

    def _validate_postgres_args(self, primitive: str, args: dict[str, Any]) -> dict[str, Any]:
        if primitive == "postgres_verify_restore":
            require_fields(args, {"restore_id"}, {"checks"})
            try: uuid.UUID(str(args["restore_id"]))
            except ValueError: raise BrokerError("invalid_restore_id")
            checks = args.get("checks", ["pg_restore_list", "database_connect", "migration_marker"])
            if not isinstance(checks, list) or not all(item in {"pg_restore_list", "database_connect", "migration_marker", "schema_count", "table_count"} for item in checks):
                raise BrokerError("invalid_restore_checks")
            return {"restore_id": str(args["restore_id"]), "checks": checks}
        require_fields(args, {"profile"} | ({"label"} if primitive == "postgres_backup" else set()), {
            "artifact_id", "rollback_artifact_id", "timeout_seconds", "expected_migration", "template", "parameters"
        })
        profile = self.policy.profile("postgres_profiles", args["profile"])
        result: dict[str, Any] = {"profile": profile["name"]}
        if primitive == "postgres_backup":
            result["label"] = ensure_name(args["label"], "backup_label")
        for key in ("artifact_id", "rollback_artifact_id"):
            if key in args and args[key] is not None:
                artifact = self.artifact(args[key]); result[key] = artifact.artifact_id; result[f"{key}_sha256"] = artifact.sha256
        if primitive == "postgres_restore_ephemeral":
            if "artifact_id" not in result: raise BrokerError("artifact_required")
            timeout = args.get("timeout_seconds", 1800)
            if not isinstance(timeout, int) or not 1 <= timeout <= 3600: raise BrokerError("invalid_step_timeout")
            result["timeout_seconds"] = timeout
        if primitive == "postgres_migration_apply":
            if "artifact_id" not in result or "rollback_artifact_id" not in result: raise BrokerError("migration_artifacts_required")
            result["expected_migration"] = ensure_name(args.get("expected_migration"), "expected_migration")
        if primitive == "postgres_rollback" and "artifact_id" not in result:
            raise BrokerError("artifact_required")
        if primitive == "postgres_query_template":
            template = ensure_name(args.get("template"), "query_template")
            template_spec = self.raw_policy["query_templates"].get(template)
            if not isinstance(template_spec, dict) or template_spec.get("postgres_profile") != profile["name"]:
                raise BrokerError("query_template_not_allowed")
            parameters = args.get("parameters", [])
            if not isinstance(parameters, list) or len(parameters) > 20 or not all(isinstance(item, str) and len(item) <= 500 for item in parameters):
                raise BrokerError("invalid_query_parameters")
            result.update({"template": template, "parameters": parameters})
        return result

    def _validate_n8n_args(self, primitive: str, args: dict[str, Any]) -> dict[str, Any]:
        if primitive == "n8n_diff_workflow":
            require_fields(args, {"left_artifact_id", "right_artifact_id"})
            left = self.artifact(args["left_artifact_id"]); right = self.artifact(args["right_artifact_id"])
            return {"left_artifact_id": left.artifact_id, "left_sha256": left.sha256, "right_artifact_id": right.artifact_id, "right_sha256": right.sha256}
        require_fields(args, {"profile"}, {"workflow_id", "artifact_id", "timeout_seconds"})
        profile = self.policy.profile("n8n_profiles", args["profile"])
        result: dict[str, Any] = {"profile": profile["name"]}
        if primitive != "n8n_inventory":
            if primitive == "n8n_import_candidate":
                if "workflow_id" in args:
                    raise BrokerError("candidate_must_be_created_new")
            else:
                result["workflow_id"] = ensure_name(args.get("workflow_id"), "workflow_id")
        if "artifact_id" in args:
            artifact = self.artifact(args["artifact_id"]); result["artifact_id"] = artifact.artifact_id; result["artifact_sha256"] = artifact.sha256
        if primitive in {"n8n_import_candidate", "n8n_restore_workflow"} and "artifact_id" not in result:
            raise BrokerError("artifact_required")
        if primitive == "n8n_test_execution":
            timeout = args.get("timeout_seconds", 300)
            if not isinstance(timeout, int) or not 1 <= timeout <= 900: raise BrokerError("invalid_step_timeout")
            webhooks = profile.get("test_webhooks", {})
            webhook = webhooks.get(result["workflow_id"]) if isinstance(webhooks, dict) else None
            if not isinstance(webhook, str):
                raise BrokerError("n8n_test_webhook_not_allowed")
            parsed = urllib.parse.urlsplit(webhook)
            if parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password:
                raise BrokerError("n8n_test_webhook_invalid")
            allowed_hosts = profile.get("allowed_test_hosts", ["127.0.0.1", "localhost"])
            if not isinstance(allowed_hosts, list) or parsed.hostname not in allowed_hosts:
                raise BrokerError("n8n_test_webhook_host_not_allowed")
            result["test_webhook"] = webhook
            result["timeout_seconds"] = timeout
        return result

    def _validate_object_args(self, primitive: str, args: dict[str, Any]) -> dict[str, Any]:
        require_fields(args, {"profile"}, {"prefix", "artifact_id", "key", "source_key", "destination_key", "expected_sha256"})
        profile = self.policy.profile("object_storage_profiles", args["profile"])
        result: dict[str, Any] = {"profile": profile["name"]}
        for key_name in ("prefix", "key", "source_key", "destination_key"):
            if key_name in args:
                result[key_name] = self._object_key(profile, args[key_name], allow_empty=(key_name == "prefix"))
        if "artifact_id" in args:
            artifact = self.artifact(args["artifact_id"]); result["artifact_id"] = artifact.artifact_id; result["artifact_sha256"] = artifact.sha256
        if "expected_sha256" in args and args["expected_sha256"] is not None:
            result["expected_sha256"] = ensure_sha256(args["expected_sha256"], "expected_sha256")
        if primitive == "object_storage_put" and "artifact_id" not in result: raise BrokerError("artifact_required")
        if primitive in {"object_storage_get", "object_storage_verify"} and "key" not in result: raise BrokerError("object_key_required")
        if primitive == "object_storage_copy" and not {"source_key", "destination_key"}.issubset(result): raise BrokerError("object_keys_required")
        return result

    def _object_key(self, profile: dict[str, Any], value: Any, allow_empty: bool = False) -> str:
        if not isinstance(value, str) or (not value and not allow_empty) or len(value) > 1024 or "\x00" in value or value.startswith("/") or ".." in value.split("/"):
            raise BrokerError("invalid_object_key")
        prefixes = profile.get("allowed_prefixes", [""])
        if not isinstance(prefixes, list) or not any(value.startswith(str(prefix)) for prefix in prefixes):
            raise BrokerError("object_key_not_allowed")
        return value

    def prepare(self, request: dict[str, Any]) -> dict[str, Any]:
        require_fields(request, {"operation", "mission_id", "work_id", "technical_authority", "idempotency_key", "procedure"})
        if request["technical_authority"] != "JA-023":
            raise BrokerError("technical_authority_not_recognized")
        mission_id = ensure_identifier(request["mission_id"], "mission_id")
        work_id = ensure_identifier(request["work_id"], "work_id")
        idempotency_key = ensure_identifier(request["idempotency_key"], "idempotency_key")
        procedure = request["procedure"]
        if not isinstance(procedure, dict): raise BrokerError("invalid_procedure")
        require_fields(procedure, {"procedure_id", "title", "steps"}, {"run_budget_seconds"})
        procedure_id = ensure_identifier(procedure["procedure_id"], "procedure_id")
        if not isinstance(procedure["title"], str) or not 1 <= len(procedure["title"]) <= 240: raise BrokerError("invalid_procedure_title")
        raw_steps = procedure["steps"]
        if not isinstance(raw_steps, list) or not 1 <= len(raw_steps) <= self.raw_policy["max_steps"]: raise BrokerError("invalid_procedure_steps")
        steps = [self.validate_step(step) for step in raw_steps]
        ids = [step["step_id"] for step in steps]
        if len(ids) != len(set(ids)): raise BrokerError("duplicate_step_id")
        run_budget = procedure.get("run_budget_seconds", self.raw_policy["max_run_seconds"])
        if not isinstance(run_budget, int) or not 1 <= run_budget <= self.raw_policy["max_run_seconds"]: raise BrokerError("invalid_run_budget")
        normalized = {"procedure_id": procedure_id, "title": procedure["title"], "run_budget_seconds": run_budget, "steps": steps}
        procedure_sha = sha256_bytes(canonical_json(normalized))
        existing = self._find_idempotent_plan(mission_id, work_id, idempotency_key, procedure_sha)
        if existing:
            run_path = RUN_DIR / f"{existing['plan_id']}.json"
            if existing.get("state") == "prepared" and not run_path.exists():
                token = secrets.token_urlsafe(32)
                prepared = now()
                existing["prepared_at"] = iso(prepared)
                existing["expires_at"] = iso(prepared + dt.timedelta(seconds=self.raw_policy["plan_ttl_seconds"]))
                existing["token_sha256"] = sha256_bytes(token.encode())
                atomic_json(PLAN_DIR / f"{existing['plan_id']}.json", existing)
                public = {key: value for key, value in existing.items() if key not in {"token_sha256", "procedure", "state"}}
                return public | {
                    "execution_token": token, "steps": existing["procedure"]["steps"],
                    "may_execute_same_turn": True, "requires_human_confirmation": False,
                    "replayed": True, "execution_token_rotated": True,
                }
            public = {key: value for key, value in existing.items() if key not in {"token_sha256", "procedure"}}
            return public | {"replayed": True, "may_execute_same_turn": False}
        plan_id = str(uuid.uuid4()); token = secrets.token_urlsafe(32); prepared = now()
        risk = "read_only" if all(step["primitive"] in self.READ_ONLY_PRIMITIVES for step in steps) else "reversible_technical_change"
        plan = {
            "schema": "elan-vps-v1.3-plan-v1", "plan_id": plan_id, "mission_id": mission_id, "work_id": work_id,
            "technical_authority": "JA-023", "idempotency_key": idempotency_key, "prepared_at": iso(prepared),
            "expires_at": iso(prepared + dt.timedelta(seconds=self.raw_policy["plan_ttl_seconds"])), "state": "prepared",
            "procedure": normalized, "procedure_sha256": procedure_sha, "risk": risk,
            "token_sha256": sha256_bytes(token.encode()), "capability_hash": self.capability_hash, "policy_hash": self.policy_hash,
        }
        atomic_json(PLAN_DIR / f"{plan_id}.json", plan)
        append_audit({"timestamp": iso(), "operation": "prepare_procedure", "plan_id": plan_id, "mission_id": mission_id, "work_id": work_id, "procedure_id": procedure_id, "procedure_sha256": procedure_sha, "risk": risk, "result": "success"})
        return {key: value for key, value in plan.items() if key not in {"token_sha256", "procedure", "state"}} | {"execution_token": token, "steps": steps, "may_execute_same_turn": True, "requires_human_confirmation": False, "replayed": False}

    def _find_idempotent_plan(self, mission_id: str, work_id: str, key: str, procedure_sha: str) -> dict[str, Any] | None:
        for path in PLAN_DIR.glob("*.json"):
            try:
                plan = json.loads(path.read_text(encoding="utf-8"))
                if plan.get("mission_id") == mission_id and plan.get("work_id") == work_id and plan.get("idempotency_key") == key:
                    if plan.get("procedure_sha256") != procedure_sha: raise BrokerError("idempotency_conflict")
                    return plan
            except BrokerError: raise
            except Exception: continue
        return None

    def _load_plan(self, plan_id: str) -> dict[str, Any]:
        try: value = json.loads((PLAN_DIR / f"{plan_id}.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError): raise BrokerError("plan_unavailable")
        if not isinstance(value, dict): raise BrokerError("plan_invalid")
        return value

    def start_run(self, request: dict[str, Any]) -> dict[str, Any]:
        require_fields(request, {"operation", "plan_id", "execution_token", "procedure_sha256"}, {"mode"})
        plan_id = str(request["plan_id"])
        try: uuid.UUID(plan_id)
        except ValueError: raise BrokerError("invalid_plan_id")
        plan = self._load_plan(plan_id)
        token = request["execution_token"]
        if not isinstance(token, str) or not secrets.compare_digest(sha256_bytes(token.encode()), str(plan.get("token_sha256", ""))): raise BrokerError("execution_token_invalid")
        if plan.get("procedure_sha256") != ensure_sha256(request["procedure_sha256"], "procedure_sha256"): raise BrokerError("procedure_modified")
        mode = request.get("mode", "sync")
        if mode not in {"sync", "async"}: raise BrokerError("invalid_execution_mode")
        run_path = RUN_DIR / f"{plan_id}.json"
        if run_path.exists():
            receipt = json.loads(run_path.read_text(encoding="utf-8"))
            if receipt.get("status") in {"succeeded", "failed_rolled_back", "failed_critical", "cancelled", "interrupted"}: return receipt | {"replayed": True}
            if receipt.get("status") in {"queued", "running", "cancelling"}: return receipt | {"replayed": True}
        expires = dt.datetime.fromisoformat(str(plan["expires_at"]).replace("Z", "+00:00"))
        if now() >= expires: raise BrokerError("plan_expired")
        initial = {
            "schema": "elan-vps-v1.3-run-v1", "run_id": plan_id, "plan_id": plan_id, "mission_id": plan["mission_id"],
            "work_id": plan["work_id"], "procedure_id": plan["procedure"]["procedure_id"], "procedure_sha256": plan["procedure_sha256"],
            "status": "queued", "queued_at": iso(), "started_at": None, "finished_at": None, "current_step": None,
            "steps": [], "rollbacks": [], "failed_control": None, "duration_ms": 0, "heartbeat_at": iso(), "replayed": False,
            "capability_hash": self.capability_hash, "policy_hash": self.policy_hash,
        }
        atomic_json(run_path, initial)
        cancel_event = threading.Event(); self.cancel_events[plan_id] = cancel_event
        if mode == "async":
            thread = threading.Thread(target=self._execute_run, args=(plan, cancel_event), daemon=True, name=f"elan-run-{plan_id[:8]}")
            thread.start()
            return initial | {"asynchronous": True}
        self._execute_run(plan, cancel_event)
        return self.get_run({"operation": "get_run", "plan_id": plan_id})

    def _execute_run(self, plan: dict[str, Any], cancel_event: threading.Event) -> None:
        plan_id = plan["plan_id"]; run_path = RUN_DIR / f"{plan_id}.json"
        if not self.run_semaphore.acquire(timeout=10):
            receipt = json.loads(run_path.read_text()); receipt.update({"status": "failed_rolled_back", "failed_control": "parallel_run_limit", "finished_at": iso()}); atomic_json(run_path, receipt); return
        started = now(); results: list[dict[str, Any]] = []; rollbacks: list[dict[str, Any]] = []; outcome = "succeeded"; failed_control = None
        try:
            receipt = json.loads(run_path.read_text()); receipt.update({"status": "running", "started_at": iso(started), "heartbeat_at": iso()}); atomic_json(run_path, receipt)
            deadline = started + dt.timedelta(seconds=plan["procedure"]["run_budget_seconds"])
            result_map: dict[str, Any] = {}
            for step in plan["procedure"]["steps"]:
                if cancel_event.is_set(): raise BrokerError("run_cancelled")
                if now() >= deadline: raise BrokerError("run_budget_exceeded")
                if not self._condition_matches(step["when"], result_map):
                    item = {"step_id": step["step_id"], "primitive": step["primitive"], "status": "skipped", "attempts": 0}
                    results.append(item); result_map[step["step_id"]] = item
                    self._checkpoint(run_path, results, rollbacks, step["step_id"]); continue
                lock = self._resource_lock(step)
                attempts = 0
                while True:
                    attempts += 1
                    try:
                        with lock:
                            value, rollback = self.execute_step(plan, step, cancel_event)
                        item = {"step_id": step["step_id"], "primitive": step["primitive"], "status": "success", "attempts": attempts, "result": sanitize(value)}
                        results.append(item); result_map[step["step_id"]] = item
                        if rollback: rollbacks.append(rollback)
                        self._checkpoint(run_path, results, rollbacks, step["step_id"])
                        break
                    except BrokerError:
                        if attempts > step["retry"] + 1: raise
                        time.sleep(step["retry_delay_seconds"])
        except BrokerError as error:
            failed_control = error.code
            if error.code == "run_cancelled": outcome = "cancelled"
            else: outcome = "failed_rolled_back"
            rollback_results = []
            rollback_failed = False
            for rollback in reversed(rollbacks):
                try: rollback_results.append({"status": "success", "result": sanitize(self.rollback_step(rollback))})
                except BrokerError as rollback_error:
                    rollback_failed = True; rollback_results.append({"status": "failed", "error": rollback_error.code})
            results.append({"status": "failed", "error": error.code, "rollback": rollback_results})
            if rollback_failed: outcome = "failed_critical"
        except Exception:
            failed_control = "unexpected_execution_error"; outcome = "failed_critical"; results.append({"status": "failed", "error": failed_control})
        finally:
            finished = now()
            receipt = json.loads(run_path.read_text())
            receipt.update({"status": outcome, "finished_at": iso(finished), "heartbeat_at": iso(finished), "current_step": None, "steps": results, "rollbacks": sanitize(rollbacks), "failed_control": failed_control, "duration_ms": int((finished-started).total_seconds()*1000)})
            atomic_json(run_path, receipt)
            plan["state"] = outcome; atomic_json(PLAN_DIR / f"{plan_id}.json", plan)
            append_audit({"timestamp": iso(), "operation": "execute_procedure", "run_id": plan_id, "mission_id": plan["mission_id"], "work_id": plan["work_id"], "procedure_id": plan["procedure"]["procedure_id"], "result": outcome, "failed_control": failed_control, "duration_ms": receipt["duration_ms"]})
            self.cancel_events.pop(plan_id, None); self.run_semaphore.release()

    def _checkpoint(self, run_path: pathlib.Path, results: list[dict[str, Any]], rollbacks: list[dict[str, Any]], current_step: str) -> None:
        value = json.loads(run_path.read_text()); value.update({"steps": results, "rollbacks": sanitize(rollbacks), "current_step": current_step, "heartbeat_at": iso()}); atomic_json(run_path, value)

    def _condition_matches(self, condition: dict[str, Any], results: dict[str, Any]) -> bool:
        if condition["mode"] == "always": return True
        source = results.get(condition["step_id"])
        if source is None: return False
        current: Any = source
        for part in condition["path"].split("."):
            if not isinstance(current, dict) or part not in current: return False
            current = current[part]
        return current == condition["value"]

    def _resource_lock(self, step: dict[str, Any]) -> threading.RLock:
        name = step.get("resource_lock") or self._default_resource(step)
        with self.lock:
            return self.resource_locks.setdefault(name, threading.RLock())

    def _default_resource(self, step: dict[str, Any]) -> str:
        primitive = step["primitive"]; args = step["args"]
        if primitive == "qualified_release_install": return "qualified-release"
        if primitive.startswith("postgres_"): return f"postgres:{args.get('profile', 'unknown')}"
        if primitive.startswith("n8n_"): return f"n8n:{args.get('profile', 'unknown')}"
        if primitive.startswith("object_storage_"): return f"object:{args.get('profile', 'unknown')}"
        if primitive.startswith("docker_"): return "docker"
        if primitive.startswith("systemd_"): return f"systemd:{args.get('unit', 'daemon')}"
        if "destination" in args: return f"path:{args['destination']}"
        return f"primitive:{primitive}"

    def execute_step(self, plan: dict[str, Any], step: dict[str, Any], cancel_event: threading.Event) -> tuple[dict[str, Any], dict[str, Any] | None]:
        primitive = step["primitive"]; args = step["args"]; run_id = plan["plan_id"]
        run_root = RUN_DIR / run_id; run_root.mkdir(parents=True, exist_ok=True, mode=0o700)
        if primitive == "file_inventory":
            items=[]
            for value in args["paths"]:
                path=self.policy.read_path(value); metadata=path.lstat()
                if path.is_symlink() or not stat.S_ISREG(metadata.st_mode): raise BrokerError("inventory_path_invalid")
                items.append({"path":str(path),"size_bytes":metadata.st_size,"mode":f"0{metadata.st_mode&0o777:03o}","mtime_ns":metadata.st_mtime_ns,"sha256":sha256_file(path)})
            return {"items":items},None
        if primitive == "file_preflight": return self._exec_file_preflight(args),None
        if primitive == "protected_reference_check": return self._exec_reference_check(args),None
        if primitive in {"install_file_atomic","generated_artifact_export"}: return self._exec_install(args,run_root,step["step_id"])
        if primitive == "qualified_release_install": return self._exec_qualified_release_install(args,run_root,step["step_id"])
        if primitive == "remove_file": return self._exec_remove(args,run_root,step["step_id"])
        if primitive == "systemd_unit": return self._exec_systemd(args)
        if primitive == "systemd_status": return self._systemd_status(args["unit"]),None
        if primitive == "journal_read": return self._journal_read(args),None
        if primitive == "http_probe": return self._http_probe(args),None
        if primitive == "host_status": return self._host_status(),None
        if primitive == "certificate_status": return self._certificate_status(args),None
        if primitive == "docker_image_load": return self._docker_image_load(args,step["timeout_seconds"]),None
        if primitive == "docker_inventory": return self._docker_inventory(),None
        if primitive == "docker_logs": return self._docker_logs(args),None
        if primitive == "docker_compose_apply": return self._docker_compose_apply(args,run_root,step["step_id"])
        if primitive == "docker_health_wait": return self._docker_health_wait(args,cancel_event),None
        if primitive.startswith("postgres_"): return self._exec_postgres(plan,primitive,args,run_root,step,cancel_event)
        if primitive.startswith("n8n_"): return self._exec_n8n(plan,primitive,args,run_root,step,cancel_event)
        if primitive.startswith("object_storage_"): return self._exec_object(plan,primitive,args,run_root,step,cancel_event)
        if primitive == "generated_artifact_list": return self._artifact_list(args),None
        if primitive == "generated_artifact_manifest": return sanitize(self.artifact(args["artifact_id"]).manifest),None
        if primitive == "isolated_python": return self._isolated_python(plan,args,run_root,step),None
        raise BrokerError("primitive_not_implemented")

    def _exec_file_preflight(self,args:dict[str,Any])->dict[str,Any]:
        items=[]
        for spec in args["items"]:
            path=self.policy.read_path(spec["path"]); before=path.lstat()
            if path.is_symlink() or not stat.S_ISREG(before.st_mode): raise BrokerError("preflight_path_invalid")
            checksum=sha256_file(path); after=path.lstat()
            if (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_mode,before.st_uid,before.st_gid)!=(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_mode,after.st_uid,after.st_gid): raise BrokerError("preflight_path_changed")
            mode=f"0{after.st_mode&0o777:03o}"
            if checksum!=spec["expected_sha256"]: raise BrokerError("preflight_sha256_mismatch")
            if spec.get("expected_mode") and mode!=str(spec["expected_mode"]).zfill(4): raise BrokerError("preflight_mode_mismatch")
            if spec.get("expected_uid") is not None and after.st_uid!=spec["expected_uid"]: raise BrokerError("preflight_uid_mismatch")
            if spec.get("expected_gid") is not None and after.st_gid!=spec["expected_gid"]: raise BrokerError("preflight_gid_mismatch")
            items.append({"path":str(path),"size_bytes":after.st_size,"mtime_ns":after.st_mtime_ns,"mode":mode,"owner_uid":after.st_uid,"owner_gid":after.st_gid,"sha256":checksum,"stable_during_hash":True})
        return {"verdict":"PASS","items":items,"business_rows_emitted":False,"secret_values_emitted":False}

    def _exec_reference_check(self,args:dict[str,Any])->dict[str,Any]:
        ref=self.policy.protected_reference(args["profile"]); path=pathlib.Path(ref["path"]); metadata=path.lstat()
        if path.is_symlink() or not stat.S_ISREG(metadata.st_mode): raise BrokerError("protected_reference_invalid")
        mode=f"0{metadata.st_mode&0o777:03o}"
        if ref.get("expected_mode") and mode!=str(ref["expected_mode"]).zfill(4): raise BrokerError("protected_reference_mode_mismatch")
        if ref.get("expected_uid") is not None and metadata.st_uid!=ref["expected_uid"]: raise BrokerError("protected_reference_owner_mismatch")
        if ref.get("expected_gid") is not None and metadata.st_gid!=ref["expected_gid"]: raise BrokerError("protected_reference_owner_mismatch")
        if ref.get("require_nonzero",True) and metadata.st_size<=0: raise BrokerError("protected_reference_empty")
        return {"profile":ref["name"],"present":True,"mode":mode,"owner_uid":metadata.st_uid,"owner_gid":metadata.st_gid,"size_nonzero":metadata.st_size>0,"value_read":False,"value_emitted":False}

    def _exec_install(self,args:dict[str,Any],run_root:pathlib.Path,step_id:str)->tuple[dict[str,Any],dict[str,Any]]:
        artifact=self.artifact(args["artifact_id"])
        if artifact.sha256!=args["artifact_sha256"]: raise BrokerError("artifact_changed_after_plan")
        destination=self.policy.write_path(args["destination"]); destination.parent.mkdir(parents=True,exist_ok=True,mode=0o755)
        backup=run_root/f"backup-{step_id}"; existed=destination.exists()
        if existed:
            metadata=destination.lstat()
            if destination.is_symlink() or not stat.S_ISREG(metadata.st_mode): raise BrokerError("destination_not_regular_file")
            shutil.copy2(destination,backup); backup.chmod(0o600)
        temporary=destination.parent/f".{destination.name}.{uuid.uuid4().hex}.tmp"
        try:
            shutil.copyfile(artifact.path,temporary); os.chmod(temporary,int(args["mode"],8)); os.replace(temporary,destination)
            if sha256_file(destination)!=artifact.sha256: raise BrokerError("installed_file_hash_mismatch")
        except Exception:
            temporary.unlink(missing_ok=True)
            if existed and backup.is_file(): shutil.copy2(backup,destination)
            elif not existed: destination.unlink(missing_ok=True)
            raise
        return {"destination":str(destination),"sha256":artifact.sha256,"mode":args["mode"],"replaced_existing":existed},{"primitive":"restore_file","destination":str(destination),"backup":str(backup) if existed else None}

    def _qualified_installation_plan(self,source_root:str,version:str)->list[dict[str,str]]:
        helper_root=f"/usr/local/lib/elan-vps-v1/releases/{version}"
        return [
            {"step_id":"install-release-manifest","source":f"{source_root}/release-manifest.json","destination":"/etc/elan-vps-v1/release-manifest.json","mode":"0600"},
