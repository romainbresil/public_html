            "object_storage_copy": spec("reversible", {"profile": "object-storage-profile", "source_key": "allowed-key", "destination_key": "allowed-key"}, "Copy one allowlisted object."),
            "object_storage_verify": spec("read_only", {"profile": "object-storage-profile", "key": "allowed-key", "expected_sha256": "sha256?"}, "Verify object metadata and optional digest."),
