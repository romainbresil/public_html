class Policy:
    def __init__(self, raw: dict[str, Any]):
        self.raw = raw
        self.read_roots = tuple(pathlib.Path(item).resolve() for item in raw["allowed_read_roots"])
        self.write_roots = tuple(pathlib.Path(os.path.normpath(item)) for item in raw["allowed_write_roots"])
        self.write_paths = frozenset(os.path.normpath(item) for item in raw["allowed_write_paths"])
        self.allowed_units = frozenset(raw["allowed_systemd_units"])
        self.allowed_hosts = frozenset(host.lower() for host in raw["allowed_https_hosts"])
        self.connector_hosts = CONNECTOR_TRANSFER_HOSTS
        self.allowed_certificate_hosts = frozenset(host.lower() for host in raw["allowed_certificate_hosts"])
        self.allowed_probes = frozenset(raw["allowed_http_probes"])

    @staticmethod
    def _under(path: pathlib.Path, roots: tuple[pathlib.Path, ...]) -> bool:
        return any(path == root or root in path.parents for root in roots)

    def read_path(self, value: Any) -> pathlib.Path:
        if not isinstance(value, str) or not value.startswith("/") or "\x00" in value:
            raise BrokerError("invalid_read_path")
        resolved = pathlib.Path(value).resolve(strict=False)
        if not self._under(resolved, self.read_roots):
            raise BrokerError("read_path_not_allowed")
        return resolved

    def write_path(self, value: Any) -> pathlib.Path:
        if not isinstance(value, str) or not value.startswith("/") or "\x00" in value:
            raise BrokerError("invalid_write_path")
        path = pathlib.Path(value)
        if ".." in path.parts:
            raise BrokerError("invalid_write_path")
        lexical = pathlib.Path(os.path.normpath(value))
        if not self._under(lexical, self.write_roots) and str(lexical) not in self.write_paths:
            raise BrokerError("write_path_not_allowed")
        cursor = pathlib.Path("/")
        for part in lexical.parts[1:]:
            cursor /= part
            try:
                metadata = cursor.lstat()
            except FileNotFoundError:
                continue
            except OSError:
                raise BrokerError("write_path_uninspectable")
            if stat.S_ISLNK(metadata.st_mode):
                raise BrokerError("write_parent_symlink_refused")
        return lexical

    def https_url(self, value: Any, *, allow_connector: bool = False) -> str:
        if not isinstance(value, str) or len(value) > 4096:
            raise BrokerError("invalid_https_url")
        parsed = urllib.parse.urlsplit(value)
        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.fragment:
            raise BrokerError("https_url_refused")
        host = parsed.hostname.lower()
        if host in self.allowed_hosts:
            return value
        connector_allowed = any(host == allowed or host.endswith("." + allowed) for allowed in self.connector_hosts)
        if not allow_connector or not connector_allowed:
            raise BrokerError("https_host_not_allowed")
        if not re.fullmatch(r"/files/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/raw", parsed.path):
            raise BrokerError("connector_transfer_url_refused")
        query = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
        if query.get("sp") != ["r"] or not {"se", "sv", "sr", "sig"}.issubset(query):
            raise BrokerError("connector_transfer_url_refused")
        return value

    def protected_reference(self, profile: Any) -> dict[str, Any]:
        name = ensure_name(profile, "protected_reference")
        value = self.raw["protected_references"].get(name)
        if not isinstance(value, dict):
            raise BrokerError("protected_reference_not_allowed")
        path = value.get("path")
        if not isinstance(path, str) or not path.startswith("/"):
            raise BrokerError("protected_reference_invalid")
        return {**value, "name": name, "path": path}

    def profile(self, group: str, name: Any) -> dict[str, Any]:
        profile_name = ensure_name(name, f"{group}_profile")
        profiles = self.raw.get(group)
        value = profiles.get(profile_name) if isinstance(profiles, dict) else None
        if not isinstance(value, dict):
            raise BrokerError(f"{group}_profile_not_allowed")
        return {**value, "name": profile_name}


