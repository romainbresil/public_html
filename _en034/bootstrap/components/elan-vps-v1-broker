def load_policy(path: pathlib.Path = CONFIG_PATH) -> dict[str, Any]:
    policy = default_policy()
    if path.exists():
        raw = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("invalid_policy")
        policy.update(raw)
    list_keys = (
        "allowed_read_roots", "allowed_write_roots", "allowed_write_paths", "allowed_systemd_units",
        "allowed_https_hosts", "allowed_certificate_hosts", "allowed_http_probes",
    )
    for key in list_keys:
        if not isinstance(policy.get(key), list) or not all(isinstance(item, str) and item for item in policy[key]):
            raise ValueError(f"invalid_{key}")
    map_keys = (
        "protected_references", "credential_profiles", "postgres_profiles", "n8n_profiles",
        "compose_profiles", "object_storage_profiles", "query_templates",
    )
    for key in map_keys:
        if not isinstance(policy.get(key), dict):
            raise ValueError(f"invalid_{key}")
    for key, minimum, maximum in (
        ("max_artifact_bytes", 1024, 1_073_741_824),
        ("max_generated_artifact_bytes", 1024, 4_294_967_296),
        ("max_inline_text_bytes", 1024, 240_000),
        ("max_steps", 1, 200),
        ("plan_ttl_seconds", 60, 86_400),
        ("max_step_timeout_seconds", 10, 7200),
        ("max_run_seconds", 60, 86_400),
        ("max_retry_count", 0, 10),
        ("max_parallel_runs", 1, 8),
        ("max_log_bytes", 4096, 1_048_576),
    ):
        item = policy.get(key)
        if not isinstance(item, int) or isinstance(item, bool) or not minimum <= item <= maximum:
            raise ValueError(f"invalid_{key}")
    return policy


