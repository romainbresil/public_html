            {"step_id":"install-compose","source":f"{source_root}/deployment/compose.yaml","destination":"/opt/elan-vps-v1/compose.yaml","mode":"0600"},
            {"step_id":"install-broker-service","source":f"{source_root}/deployment/systemd/elan-vps-v1-broker.service","destination":"/etc/systemd/system/elan-vps-v1-broker.service","mode":"0644"},
            {"step_id":"install-gateway-service","source":f"{source_root}/deployment/systemd/elan-vps-v1-gateway.service","destination":"/etc/systemd/system/elan-vps-v1-gateway.service","mode":"0644"},
