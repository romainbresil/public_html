RELEASE_MANIFEST_PATH = pathlib.Path(os.environ.get("ELAN_RELEASE_MANIFEST", "/etc/elan-vps-v1/release-manifest.json"))


def load_release_contract() -> dict[str, Any]:
    path = RELEASE_MANIFEST_PATH
    if not path.exists():
        source_path = pathlib.Path(__file__).resolve().parents[1] / "release-manifest.json"
        if source_path.exists():
            path = source_path
    value = json.loads(path.read_text(encoding="utf-8"))
    version = value.get("version") if isinstance(value, dict) else None
    hosts = value.get("connector_transfer_hosts") if isinstance(value, dict) else None
    plan = value.get("installation_plan") if isinstance(value, dict) else None
    if value.get("schema") != "elan-vps-v1.3-release-v1" or not isinstance(version, str) or not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
        raise RuntimeError("release_manifest_invalid")
    if not isinstance(hosts, list) or not hosts or not all(isinstance(host, str) and re.fullmatch(r"[a-z0-9.-]+", host) for host in hosts):
        raise RuntimeError("connector_transfer_hosts_invalid")
    if not isinstance(plan, list) or not 1 <= len(plan) <= 40:
        raise RuntimeError("release_installation_plan_invalid")
    step_ids: set[str] = set()
    destinations: set[str] = set()
    for item in plan:
        if not isinstance(item, dict) or set(item) != {"step_id", "source", "destination", "mode"}:
            raise RuntimeError("release_installation_plan_invalid")
        step_id, source, destination, mode = item["step_id"], item["source"], item["destination"], item["mode"]
        if not isinstance(step_id, str) or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,180}", step_id) or step_id in step_ids:
            raise RuntimeError("release_installation_plan_invalid")
        if not isinstance(source, str) or not source.startswith(value.get("source_root", "") + "/") or ".." in pathlib.PurePosixPath(source).parts:
            raise RuntimeError("release_installation_plan_invalid")
        if not isinstance(destination, str) or not destination.startswith("/") or destination in destinations:
            raise RuntimeError("release_installation_plan_invalid")
        if not isinstance(mode, str) or not re.fullmatch(r"0[0-7]{3}", mode):
            raise RuntimeError("release_installation_plan_invalid")
        step_ids.add(step_id); destinations.add(destination)
    return value


