class Broker:
    READ_ONLY_PRIMITIVES = {
        "file_inventory", "file_preflight", "protected_reference_check", "http_probe", "systemd_status",
        "journal_read", "docker_inventory", "docker_logs", "host_status", "certificate_status",
        "postgres_inventory", "postgres_verify_restore", "postgres_query_template", "n8n_inventory",
        "n8n_export_workflow", "n8n_diff_workflow", "n8n_credentials_reference_check", "object_storage_inventory",
        "generated_artifact_list", "generated_artifact_manifest",
    }

    def __init__(self, policy: dict[str, Any]):
        self.raw_policy = policy
        self.policy = Policy(policy)
        self.lock = threading.RLock()
        self.run_semaphore = threading.BoundedSemaphore(policy["max_parallel_runs"])
        self.cancel_events: dict[str, threading.Event] = {}
        self.resource_locks: dict[str, threading.RLock] = {}
        for directory in (STATE_DIR, ARTIFACT_DIR, PLAN_DIR, RUN_DIR, RESTORE_DIR):
            directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.schemas = self._primitive_schemas()
        self.capability_hash = sha256_bytes(canonical_json(self.schemas))
        self.policy_hash = sha256_bytes(canonical_json(self._public_policy()))
        self._mark_interrupted_runs()

    def _public_policy(self) -> dict[str, Any]:
        return {
            "policy_version": self.raw_policy["policy_version"],
            "minimum_client_version": self.raw_policy["minimum_client_version"],
            "profiles": {
                "postgres": sorted(self.raw_policy["postgres_profiles"]),
                "n8n": sorted(self.raw_policy["n8n_profiles"]),
                "compose": sorted(self.raw_policy["compose_profiles"]),
                "object_storage": sorted(self.raw_policy["object_storage_profiles"]),
                "credential": sorted(self.raw_policy["credential_profiles"]),
                "protected_reference": sorted(self.raw_policy["protected_references"]),
            },
            "limits": {key: self.raw_policy[key] for key in (
                "max_artifact_bytes", "max_generated_artifact_bytes", "max_steps", "plan_ttl_seconds",
                "max_step_timeout_seconds", "max_run_seconds", "max_retry_count", "max_parallel_runs", "max_log_bytes",
            )},
        }

    def _primitive_schemas(self) -> dict[str, dict[str, Any]]:
        def spec(risk: str, args: dict[str, str], description: str, rollback: bool = False) -> dict[str, Any]:
            return {"risk": risk, "args": args, "description": description, "rollback": rollback}
        return {
            "file_inventory": spec("read_only", {"paths": "absolute-path[]"}, "Inventory regular files and SHA-256."),
            "file_preflight": spec("read_only", {"items": "[{path,expected_sha256,expected_mode?,expected_uid?,expected_gid?}]"}, "Stable exact file preflight."),
            "protected_reference_check": spec("read_only", {"profile": "protected-reference-profile"}, "Check secret reference metadata without reading the value."),
            "install_file_atomic": spec("reversible", {"artifact_id": "uuid", "destination": "allowed-path", "mode": "octal"}, "Atomically install an exact artifact.", True),
            "qualified_release_install": spec("reversible", {"artifact_id": "uuid", "expected_version": "semver", "expected_source_commit": "git-sha"}, "Validate and atomically install one qualified release archive with complete rollback.", True),
            "remove_file": spec("reversible", {"destination": "allowed-path"}, "Remove an allowed regular file.", True),
            "systemd_unit": spec("reversible", {"unit": "allowed-unit", "action": "start|stop|restart|enable|disable|daemon-reload"}, "Apply an allowlisted systemd action.", True),
            "systemd_status": spec("read_only", {"unit": "allowed-unit"}, "Read active/enabled state."),
            "journal_read": spec("read_only", {"unit": "allowed-unit", "lines": "1..500"}, "Read bounded journal metadata without emitting content."),
            "http_probe": spec("read_only", {"url": "allowed-probe", "expected_status": "100..599", "json_status": "string?"}, "Probe an allowlisted local endpoint."),
            "host_status": spec("read_only", {}, "Read bounded disk, memory, load and uptime information."),
            "certificate_status": spec("read_only", {"hostname": "allowed-hostname", "port": "1..65535"}, "Read remote TLS certificate expiry without private keys."),
            "docker_image_load": spec("reversible", {"artifact_id": "uuid", "identity_artifact_id": "uuid"}, "Load an exact Docker image whose OCI manifest/config receipt is independently sealed."),
            "docker_inventory": spec("read_only", {}, "Inventory containers/images/networks/volumes with bounded output."),
            "docker_logs": spec("read_only", {"container": "allowed-container", "lines": "1..500"}, "Read bounded container-log metadata without emitting content."),
            "docker_compose_apply": spec("reversible", {"profile": "compose-profile", "artifact_id": "uuid", "wait_seconds": "1..900"}, "Apply an exact Compose release and retain the prior file.", True),
            "docker_health_wait": spec("read_only", {"containers": "allowed-container[]", "timeout_seconds": "1..900"}, "Wait for running/healthy state."),
            "postgres_inventory": spec("read_only", {"profile": "postgres-profile"}, "Read PostgreSQL version, database size and migration marker."),
            "postgres_backup": spec("reversible", {"profile": "postgres-profile", "label": "safe-name"}, "Create a custom-format backup as a generated artifact."),
            "postgres_restore_ephemeral": spec("reversible", {"profile": "postgres-profile", "artifact_id": "uuid", "timeout_seconds": "1..3600"}, "Restore into a network-disabled disposable PostgreSQL container.", True),
            "postgres_verify_restore": spec("read_only", {"restore_id": "uuid", "checks": "policy-check[]"}, "Verify an ephemeral restore using closed checks."),
            "postgres_migration_preflight": spec("read_only", {"profile": "postgres-profile", "artifact_id": "uuid", "rollback_artifact_id": "uuid?"}, "Validate exact SQL artifacts and policy."),
            "postgres_migration_apply": spec("reversible", {"profile": "postgres-profile", "artifact_id": "uuid", "rollback_artifact_id": "uuid", "expected_migration": "safe-name"}, "Apply exact SQL and retain exact rollback.", True),
            "postgres_query_template": spec("read_only", {"profile": "postgres-profile", "template": "policy-template", "parameters": "string[]"}, "Run a closed read-only query template."),
            "postgres_rollback": spec("reversible", {"profile": "postgres-profile", "artifact_id": "uuid"}, "Apply an exact rollback artifact."),
